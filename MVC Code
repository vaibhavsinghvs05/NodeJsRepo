//Middleware
-------------------------------------------------------------------------------------------------------------------------------------------------------------------------------

import { promises as fs } from "fs";  // Use fs.promises to use async/await

function middleware(filename) {
    return async (req, res, next) => {
        try {
            // Log the request data to the file
            await fs.appendFile(filename, `${req.ip} : ${req.method} : ${req.path} : ${new Date().toISOString()}\n`);
            next();  // Move to the next middleware
        } catch (error) {
            console.error('Error logging request:', error);
            next();  // Still move to the next middleware, but log the error
        }
    };
}

export default middleware;

