import User from "../models/userModel.js";

async function handlerGetAllUsersById(req, res){
    try{
        const id = req.params.id;
        console.log(`Users By ${id}`);
        const user = await User.findById(id);
        res.status(200).send(user);
        if(!user){
            return res.status(404).send({error: "Unable to find the User!"});
        }
    }
    catch(error){
        console.log(error);
        res.status(500).send({error: "Something Broken While Fetching the User!"});
    }
}

async function handlerGetAllUsers(req, res){
    try{
        console.log("All Users!!");
        const users = await User.find({});
        res.status(200).send(users);
    }
    catch(error){
        console.log(error);
        throw error;
    }
}

async function handlerPostUser(req, res){
    try{
        const userCreated = await User.create(req.body, (err)=>{
           if(err){
               console.log(err);
           }
       });
       console.log("User Created!");
       res.status(201).send(userCreated);
   }
   catch(error){
       console.log(error);
       throw error;
   }
}

async function handlerUpdateUser(req, res) {
    res.send("User Data is Updated!");
}

async function handlerDeleteUser(req, res) {
    res.send("User is Deleted!");
}

export { handlerGetAllUsersById, handlerGetAllUsers, handlerPostUser, handlerUpdateUser, handlerDeleteUser };

